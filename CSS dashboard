body {
  font-family: Arial, sans-serif;
  margin: 0;
  background-color: #eef4fb;
  color: #234a84;
}

.navbar {
  background-color: #234a84;
  color: white;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

.navbar h2 {
  margin: 0;
}

nav a {
  color: white;
  text-decoration: none;
  margin: 8px;
}

nav a:hover {
  color: #a9d5ff;
}

.container {
  max-width: 1000px;
  margin: 25px auto;
  padding: 0 20px;
}

.welcome {
  background-color: #4b8ee8;
  color: white;
  padding: 35px;
  border-radius: 12px;
  margin-bottom: 20px;
}

.welcome h1 {
  margin-top: 0;
}

.card {
  background-color: white;
  padding: 22px;
  margin-bottom: 20px;
  border-radius: 12px;
  border: 1px solid #d5e3f5;
  box-shadow: 0 3px 10px #dce6f2;
}

.card h2 {
  margin-top: 0;
}

.status {
  display: inline-block;
  background-color: #d9f7e8;
  color: #168653;
  padding: 8px 14px;
  border-radius: 20px;
}

.stats {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

.stat-box {
  background-color: #edf4ff;
  padding: 15px;
  text-align: center;
  border-radius: 10px;
  flex: 1;
  min-width: 100px;
}

.stat-box h3 {
  margin-bottom: 5px;
}

.stat-box p {
  font-size: 24px;
  font-weight: bold;
  margin: 5px;
}

.skill-bar {
  background-color: #dce7f5;
  height: 12px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 18px;
}

.skill {
  height: 12px;
  border-radius: 10px;
  background-color: #4b8ee8;
}

.html {
  width: 80%;
}

.css {
  width: 60%;
}

.desain {
  width: 70%;
}

.footer {
  background-color: #234a84;
  color: white;
  text-align: center;
  padding: 18px;
  margin-top: 30px;
}
